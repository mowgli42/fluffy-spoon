{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd .. && npm run build",
  "outputDirectory": "../dist",
  "installCommand": "cd .. && (python3 -m pip install --quiet -r requirements.txt || true)",
  "rewrites": [
    { "source": "/", "destination": "/recipe-box.html" }
  ]
}
